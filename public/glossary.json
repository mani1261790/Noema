[
  {
    "id": "td-error",
    "term": "TD誤差",
    "aliases": ["TD error", "temporal difference error"],
    "description": "現在の価値予測と、実際に得た報酬に次状態の価値を足した目標との差です。価値関数をどちらへ更新するかを決める信号になります。",
    "math": "\\delta_t = r_t + \\gamma V(s_{t+1}) - V(s_t)"
  },
  {
    "id": "value-function",
    "term": "価値関数",
    "aliases": ["value function", "V(s)"],
    "description": "ある状態から方策に従って進んだとき、将来どれくらいの報酬が期待できるかを表す関数です。",
    "math": "V^{\\pi}(s) = \\mathbb{E}_{\\pi}[G_t \\mid S_t = s]"
  },
  {
    "id": "policy",
    "term": "方策",
    "aliases": ["policy", "\\pi"],
    "description": "状態を見て、どの行動を選ぶかを決めるルールです。確率的方策では、各行動を選ぶ確率として表します。",
    "math": "\\pi(a \\mid s) = P(A_t = a \\mid S_t = s)"
  },
  {
    "id": "bellman-equation",
    "term": "ベルマン方程式",
    "aliases": ["Bellman equation"],
    "description": "現在の価値を、直近の報酬と次状態の価値に分解して表す関係式です。動的計画法や TD 学習の基礎になります。",
    "math": "V^{\\pi}(s) = \\mathbb{E}_{\\pi}[r + \\gamma V^{\\pi}(s')]"
  }
]
