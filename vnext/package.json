{
  "name": "noema-vnext",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:blog": "npm run dev --workspace @noema/blog",
    "dev:studio": "npm run dev --workspace @noema/studio",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
