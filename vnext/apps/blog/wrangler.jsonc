{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noema-learn",
  "account_id": "2ea670c2a6ff28e248ef084adf095e8b",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/og/series/*",
      "/og/articles/*"
    ]
  },
  "ratelimits": [
    { "name": "COMMENTS_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUSH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "READER_AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "noema-cms",
      "database_id": "1be074f8-8d97-4422-a081-5eeaadcb5cd0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_ASSETS",
      "bucket_name": "noema-article-assets"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PUSH_VAPID_PUBLIC_KEY": "BNdcOPow5Kevt-F6dbJqPvD3vPdkRWx1R7gixIR-uU0b6uAQLju8KwuD3TypzWaXDvvpiO-2Aol5iHQL1-mwidQ",
    "READER_AI_DAILY_LIMIT": "100"
  }
}
