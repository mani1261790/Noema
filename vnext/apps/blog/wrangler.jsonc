{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noema-learn",
  "account_id": "2ea670c2a6ff28e248ef084adf095e8b",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "noema-cms",
      "database_id": "1be074f8-8d97-4422-a081-5eeaadcb5cd0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_ASSETS",
      "bucket_name": "noema-article-assets"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
