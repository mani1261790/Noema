---
import { topicLabels, type ArticleSummary } from "@noema/content";
import { formatJapaneseDate } from "../lib/articles";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  article: ArticleSummary;
  headingLevel?: 2 | 3;
  compact?: boolean;
}

const { article, headingLevel = 2, compact = false } = Astro.props;
const topic = article.topics[0];
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
---

<a class:list={["article-row", compact && "article-row--compact"]} href={article.href}>
  <div class="article-row__body">
    <p class="article-row__topic">{topicLabel}</p>
    {headingLevel === 3
      ? <h3 class="article-row__title">{article.title}</h3>
      : <h2 class="article-row__title">{article.title}</h2>}
    <p class="article-row__excerpt">{article.excerpt}</p>
    {article.tags.length > 0 && (
      <ul class="article-row__tags" aria-label="タグ">
        {article.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    <div class="article-row__meta">
      <time datetime={article.publishedAt}>{formatJapaneseDate(article.publishedAt)}</time>
      <span class="dads-card-arrow" aria-hidden="true"><ArrowIcon /></span>
    </div>
  </div>
</a>
