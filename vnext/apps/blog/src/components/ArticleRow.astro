---
import { stageLabels, stageShortLabels, trackLabels, type ArticlePreview } from "@noema/content";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  article: ArticlePreview;
}

const { article } = Astro.props;
---

<article class="article-row">
  <div class="article-row__visual" aria-hidden="true">
    <span>{stageShortLabels[article.stage]}</span>
    {article.track !== "common" && <strong>{trackLabels[article.track].replace("トラック", "")}</strong>}
  </div>
  <div class="article-row__body">
    <h3><a href={article.href}>{article.title}</a></h3>
    <p>{article.excerpt}</p>
    <ul class="article-row__meta" aria-label="記事情報">
      <li>{stageLabels[article.stage]}</li>
      {article.track !== "common" && <li>{trackLabels[article.track]}</li>}
      <li>読了 {article.estimatedMinutes}分</li>
    </ul>
  </div>
  <time datetime={article.publishedAt}>{article.publishedAt?.replaceAll("-", ".")}</time>
  <span class="article-row__arrow"><ArrowIcon /></span>
</article>
