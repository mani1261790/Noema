---
import { topicLabels, type ArticlePreview } from "@noema/content";
import { getArticleLevelTone } from "../lib/articlePresentation";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  article: ArticlePreview;
}

const { article } = Astro.props;
const topic = article.topics[0];
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
const levelTone = getArticleLevelTone(article);
---

<a class:list={["article-row", `article-level--${levelTone}`]} href={article.href}>
  <div class="article-row__body">
    <p class="article-row__topic">{topicLabel}</p>
    <h2 class="article-row__title">{article.title}</h2>
    <p class="article-row__excerpt">{article.excerpt}</p>
    <div class="article-row__meta">
      <time datetime={article.publishedAt}>{article.publishedAt?.replaceAll("-", ".")}</time>
      <span class="dads-card-arrow" aria-hidden="true"><ArrowIcon /></span>
    </div>
  </div>
</a>
