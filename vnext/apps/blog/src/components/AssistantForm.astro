---
interface Props {
  idPrefix: string;
  headingId?: string;
  hideHeading?: boolean;
}

const { idPrefix, headingId, hideHeading = false } = Astro.props;
---

<div class="assistant-form-shell">
  {!hideHeading && <h2 id={headingId}>この記事について質問</h2>}
  <form data-assistant-form>
    <div class="assistant-conversation">
      <div class="assistant-selection" data-assistant-selection hidden>
        <div class="assistant-selection__header">
          <p>選択した本文</p>
          <button type="button" data-clear-selection>選択を解除</button>
        </div>
        <blockquote data-selected-text></blockquote>
      </div>
      <div class="assistant-answer" data-assistant-answer aria-live="polite"></div>
      <p class="assistant-status" data-assistant-status role="status" aria-live="polite"></p>
    </div>
    <div class="assistant-field assistant-field--key">
      <label for={`${idPrefix}-api-key`}>OpenAI APIキー</label>
      <div class="assistant-key-field">
        <input id={`${idPrefix}-api-key`} data-api-key type="password" autocomplete="off" spellcheck="false" />
        <button type="button" data-toggle-key aria-label="APIキーを表示" aria-pressed="false">表示</button>
      </div>
      <p><a href="https://platform.openai.com/api-keys" target="_blank" rel="noreferrer">OpenAIのAPIキーを取得</a></p>
    </div>
    <div class="assistant-suggestions" aria-label="質問の例">
      <button type="button" data-question-suggestion>一言でまとめると？</button>
      <button type="button" data-question-suggestion>身近な例で説明して</button>
      <button type="button" data-question-suggestion>どこを読み返せばいい？</button>
    </div>
    <div class="assistant-composer">
      <label class="noema-visually-hidden" for={`${idPrefix}-question`}>質問</label>
      <textarea id={`${idPrefix}-question`} data-question rows="1" maxlength="1000" placeholder="選択した本文について質問"></textarea>
      <button class="assistant-send" type="submit" aria-label="質問を送信">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m12 19V5m-6 6 6-6 6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
        </svg>
      </button>
    </div>
    <p class="assistant-privacy">APIキー、質問、記事本文、選択した本文は回答をつくるためOpenAIへ送信され、Noemaには保存されません。</p>
    <button class="assistant-clear" type="button" data-clear-conversation>会話を消去</button>
  </form>
</div>
