---
interface Props {
  idPrefix: string;
  headingId?: string;
  hideHeading?: boolean;
}

const { idPrefix, headingId, hideHeading = false } = Astro.props;
---

<div class="assistant-form-shell">
  {!hideHeading && <h2 id={headingId}>この記事について質問</h2>}
  <form data-assistant-form>
    <div class="assistant-conversation">
      <div class="assistant-selection" data-assistant-selection hidden>
        <div class="assistant-selection__header">
          <p>選択した本文</p>
          <button type="button" data-clear-selection>選択を解除</button>
        </div>
        <blockquote data-selected-text></blockquote>
      </div>
      <div class="assistant-answer" data-assistant-answer aria-live="polite"></div>
      <p class="assistant-status" data-assistant-status role="status" aria-live="polite"></p>
    </div>
    <div class="assistant-composer">
      <label class="noema-visually-hidden" for={`${idPrefix}-question`} data-composer-label>OpenAI APIキー</label>
      <textarea id={`${idPrefix}-question`} data-question data-mode="api-key" rows="1" maxlength="1000" autocomplete="off" spellcheck="false" aria-label="OpenAI APIキー" placeholder="最初にOpenAI APIキーを入力してください"></textarea>
      <button class="assistant-send" type="submit" aria-label="APIキーを設定">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m12 19V5m-6 6 6-6 6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
        </svg>
      </button>
    </div>
    <p class="assistant-privacy">APIキーはこのページ内だけで保持され、質問時にOpenAIへ送信されます。Noemaには保存されません。</p>
    <button class="assistant-clear" type="button" data-clear-conversation>会話を消去</button>
  </form>
</div>
