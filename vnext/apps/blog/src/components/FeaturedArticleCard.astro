---
import { topicLabels, type ArticlePreview } from "@noema/content";
import { getArticleApproachTone } from "../lib/articlePresentation";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  article: ArticlePreview;
}

const { article } = Astro.props;
const topic = article.topics[0];
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
const size = article.approach === "experience" || article.approach === "practice" ? "large" : "compact";
const approachTone = getArticleApproachTone(article);
---

<a class:list={["featured-article-card", `featured-article-card--${size}`, `article-approach--${approachTone}`]} href={article.href}>
  <div class="featured-article-card__body">
    <p class="featured-article-card__topic">{topicLabel}</p>
    <h3 class="featured-article-card__title">{article.title}</h3>
    <p class="featured-article-card__excerpt">{article.excerpt}</p>
    <div class="featured-article-card__meta">
      <time datetime={article.publishedAt}>{article.publishedAt?.replaceAll("-", ".")}</time>
      <span class="dads-card-arrow" aria-hidden="true"><ArrowIcon /></span>
    </div>
  </div>
</a>
