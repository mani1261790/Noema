---
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname.startsWith(href);
const links = [
  { href: "/series", label: "シリーズ" },
  { href: "/articles", label: "記事を探す" },
  { href: "/about", label: "Noemaについて" }
];
---

<header class="site-header" data-site-header>
  <div class="noema-container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Noema ホーム">Noema</a>
    <div class="site-header__actions">
      <nav class="site-header__nav" aria-label="メインメニュー">
        <ul>{links.map((link) => <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a></li>)}</ul>
      </nav>
      <button class="site-header__search" type="button" aria-expanded="false" aria-controls="site-search-panel" data-site-search-toggle>
        <svg class="noema-icon site-header__search-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m20.5 19.8-4.8-4.8a7.5 7.5 0 1 0-.7.7l4.8 4.8.7-.7ZM4 10a6 6 0 1 1 12 0 6 6 0 0 1-12 0Z" fill="currentColor" /></svg>
        <svg class="noema-icon site-header__close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        <span data-site-search-label>検索</span>
      </button>
      <button class="site-header__menu" type="button" aria-expanded="false" aria-controls="site-menu-panel" data-site-menu-toggle>
        <svg class="noema-icon site-header__menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18M3 12h18M3 17.5h18" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        <svg class="noema-icon site-header__menu-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        <span data-site-menu-label>メニュー</span>
      </button>
    </div>
  </div>

  <div id="site-search-panel" class="site-search-panel" data-site-search-panel data-open="false" aria-hidden="true" inert>
    <div class="site-search-panel__clip"><div class="noema-container site-search-panel__inner">
      <form class="site-search-form" action="/articles" method="get" role="search">
        <button class="site-search-form__submit" type="submit" aria-label="検索"><svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" fill="currentColor" /></svg></button>
        <label class="site-search-form__input"><span class="noema-visually-hidden">記事を検索</span><input data-site-search-input type="search" name="keyword" placeholder="記事を検索" autocomplete="off" /></label>
      </form>
    </div></div>
  </div>

  <div id="site-menu-panel" class="site-menu-panel" data-site-menu-panel data-open="false" aria-hidden="true" inert>
    <div class="site-menu-panel__clip"><div class="noema-container site-menu-panel__inner">
      <nav aria-label="モバイルメニュー"><ul>{links.map((link) => <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a></li>)}</ul></nav>
      <form class="site-search-form site-search-form--mobile" action="/articles" method="get" role="search">
        <button class="site-search-form__submit" type="submit" aria-label="検索"><svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" fill="currentColor" /></svg></button>
        <label class="site-search-form__input"><span class="noema-visually-hidden">記事を検索</span><input type="search" name="keyword" placeholder="記事を検索" autocomplete="off" /></label>
      </form>
    </div></div>
  </div>
</header>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const searchToggle = siteHeader?.querySelector<HTMLButtonElement>("[data-site-search-toggle]");
  const searchPanel = siteHeader?.querySelector<HTMLElement>("[data-site-search-panel]");
  const searchLabel = siteHeader?.querySelector<HTMLElement>("[data-site-search-label]");
  const menuToggle = siteHeader?.querySelector<HTMLButtonElement>("[data-site-menu-toggle]");
  const menuPanel = siteHeader?.querySelector<HTMLElement>("[data-site-menu-panel]");
  const menuLabel = siteHeader?.querySelector<HTMLElement>("[data-site-menu-label]");

  const setPanelOpen = (toggle: HTMLButtonElement | null | undefined, panel: HTMLElement | null | undefined, label: HTMLElement | null | undefined, open: boolean, closedLabel: string, returnFocus = false) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.dataset.open = String(open);
    panel.setAttribute("aria-hidden", String(!open));
    if (label) label.textContent = open ? "閉じる" : closedLabel;
    if (open) panel.removeAttribute("inert");
    else {
      panel.setAttribute("inert", "");
      if (returnFocus) toggle.focus();
    }
  };

  searchToggle?.addEventListener("click", () => {
    setPanelOpen(menuToggle, menuPanel, menuLabel, false, "メニュー");
    const open = searchToggle.getAttribute("aria-expanded") !== "true";
    setPanelOpen(searchToggle, searchPanel, searchLabel, open, "検索");
    if (open) requestAnimationFrame(() => searchPanel?.querySelector<HTMLInputElement>("input")?.focus());
  });
  menuToggle?.addEventListener("click", () => {
    setPanelOpen(searchToggle, searchPanel, searchLabel, false, "検索");
    setPanelOpen(menuToggle, menuPanel, menuLabel, menuToggle.getAttribute("aria-expanded") !== "true", "メニュー");
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (searchToggle?.getAttribute("aria-expanded") === "true") setPanelOpen(searchToggle, searchPanel, searchLabel, false, "検索", true);
    if (menuToggle?.getAttribute("aria-expanded") === "true") setPanelOpen(menuToggle, menuPanel, menuLabel, false, "メニュー", true);
  });
  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node) || siteHeader?.contains(event.target)) return;
    setPanelOpen(searchToggle, searchPanel, searchLabel, false, "検索");
    setPanelOpen(menuToggle, menuPanel, menuLabel, false, "メニュー");
  });
</script>
