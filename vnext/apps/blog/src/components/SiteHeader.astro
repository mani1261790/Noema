<header class="site-header" data-site-header>
  <div class="noema-container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Noema ホーム">Noema</a>
    <button class="site-header__search" type="button" aria-expanded="false" aria-controls="site-search-panel" data-site-search-toggle>
      <svg class="noema-icon site-header__search-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m20.5 19.8-4.8-4.8a7.5 7.5 0 1 0-.7.7l4.8 4.8.7-.7ZM4 10a6 6 0 1 1 12 0 6 6 0 0 1-12 0Z" fill="currentColor" />
      </svg>
      <svg class="noema-icon site-header__close-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span data-site-search-label>検索</span>
    </button>
  </div>

  <div id="site-search-panel" class="site-search-panel" data-site-search-panel data-open="false" aria-hidden="true" inert>
    <div class="site-search-panel__clip">
      <div class="noema-container site-search-panel__inner">
        <form class="site-search-form" action="/articles" method="get" role="search">
          <button class="site-search-form__submit" type="submit" aria-label="検索">
            <svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" fill="currentColor" />
            </svg>
          </button>
          <label class="site-search-form__input">
            <span class="noema-visually-hidden">記事を検索</span>
            <input data-site-search-input type="search" name="keyword" placeholder="記事を検索" autocomplete="off" />
          </label>
        </form>
      </div>
    </div>
  </div>
</header>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const searchToggle = siteHeader?.querySelector<HTMLButtonElement>("[data-site-search-toggle]");
  const searchPanel = siteHeader?.querySelector<HTMLElement>("[data-site-search-panel]");
  const searchLabel = siteHeader?.querySelector<HTMLElement>("[data-site-search-label]");

  const setSearchOpen = (open: boolean, returnFocus = false) => {
    if (!searchToggle || !searchPanel) return;
    searchToggle.setAttribute("aria-expanded", String(open));
    searchPanel.dataset.open = String(open);
    searchPanel.setAttribute("aria-hidden", String(!open));
    if (searchLabel) searchLabel.textContent = open ? "閉じる" : "検索";
    if (open) {
      searchPanel.removeAttribute("inert");
    } else {
      searchPanel.setAttribute("inert", "");
      if (returnFocus) searchToggle.focus();
    }
  };

  searchToggle?.addEventListener("click", () => {
    setSearchOpen(searchToggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && searchToggle?.getAttribute("aria-expanded") === "true") setSearchOpen(false, true);
  });

  document.addEventListener("pointerdown", (event) => {
    if (searchToggle?.getAttribute("aria-expanded") !== "true") return;
    if (event.target instanceof Node && !siteHeader?.contains(event.target)) setSearchOpen(false);
  });
</script>
