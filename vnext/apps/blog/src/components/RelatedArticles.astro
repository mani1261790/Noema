---
import type { ArticleSummary } from "@noema/content";
import ArticleRow from "./ArticleRow.astro";

interface Props {
  articles: ArticleSummary[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="related-articles" aria-labelledby="related-articles-heading">
    <h2 id="related-articles-heading" class="noema-section-heading">もう少し気になるなら</h2>
    <div class="article-list">
      {articles.map((article) => <ArticleRow article={article} headingLevel={3} />)}
    </div>
  </section>
)}
