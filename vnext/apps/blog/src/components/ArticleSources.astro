---
import type { ArticleFrontmatter } from "@noema/content";
import { formatJapaneseDate } from "../lib/articles";

interface Props {
  sources: ArticleFrontmatter["sources"];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="article-sources" aria-labelledby="article-sources-heading">
    <h2 id="article-sources-heading">参考資料</h2>
    <ul class="dads-list">
      {sources.map((source) => (
        <li>
          <a class="dads-link" href={source.url} target="_blank" rel="noreferrer">
            {source.title}<span class="noema-visually-hidden">（新しいタブで開きます）</span>
          </a>
          <span>（{formatJapaneseDate(source.checkedAt)}確認）</span>
        </li>
      ))}
    </ul>
  </section>
)}
