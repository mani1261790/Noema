---
interface Props {
  slug?: string;
}

const { slug } = Astro.props as Props;
const updatesHref = slug ? `/updates#from=${encodeURIComponent(slug)}` : "/updates";
---

<aside class="article-updates" aria-labelledby="article-updates-heading">
  <h2 id="article-updates-heading">Noemaの更新を受け取る</h2>
  <p>RSSで新しい記事を受け取れます。登録は不要です。</p>
  <a class="dads-button" data-size="md" data-type="outline" data-analytics-updates href={updatesHref}>
    RSSの使い方を見る
  </a>
</aside>
