---
import AssistantForm from "./AssistantForm.astro";

interface Props {
  preview?: boolean;
  slug: string;
}

const { preview = false, slug } = Astro.props;
---

<button class="assistant-selection-chip" type="button" data-assistant-selection-chip aria-controls="article-assistant-panel" aria-expanded="false" hidden>
  <svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
    <path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-2.9 2-2.9 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
    <path d="M12 17h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.5" />
  </svg>
  AIに質問
</button>

<aside
  id="article-assistant-panel"
  class="assistant-panel"
  data-assistant-panel
  data-article-preview={preview ? "true" : "false"}
  data-article-slug={slug}
  aria-labelledby="assistant-panel-heading"
  aria-hidden="true"
  inert
>
  <div class="assistant-panel__header">
    <h2 id="assistant-panel-heading">この記事について質問</h2>
    <button type="button" class="assistant-panel__close" data-close-assistant aria-label="質問パネルを閉じる">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>
  <AssistantForm idPrefix="panel" hideHeading />
</aside>

<script>
  const panel = document.querySelector<HTMLElement>("[data-assistant-panel]");
  const articleSlug = panel?.dataset.articleSlug;
  const previewArticle = panel?.dataset.articlePreview === "true";
  const articlePage = panel?.closest(".article-page") as HTMLElement | null | undefined;
  const closeButton = document.querySelector<HTMLButtonElement>("[data-close-assistant]");
  const selectionChip = document.querySelector<HTMLButtonElement>("[data-assistant-selection-chip]");
  const articleBody = document.querySelector<HTMLElement>(".article-body");
  let selectedText = "";
  let selectionCandidate = "";
  let lastOpener: HTMLButtonElement | null = null;
  const dispatchAssistantOpen = () => {
    document.dispatchEvent(new CustomEvent("noema:analytics", {
      detail: { eventType: "assistant_open" }
    }));
  };
  const isPanelOpen = () => articlePage?.dataset.assistantOpen === "true";
  const syncSelectionContext = () => {
    document.querySelectorAll<HTMLElement>("[data-assistant-selection]").forEach((selection) => {
      const selectedTextElement = selection.querySelector<HTMLElement>("[data-selected-text]");
      selection.hidden = !selectedText;
      if (selectedTextElement) selectedTextElement.textContent = selectedText;
    });
    document.querySelectorAll<HTMLTextAreaElement>("[data-question]").forEach((questionInput) => {
      if (questionInput.dataset.mode === "api-key") return;
      questionInput.placeholder = selectedText
        ? "選択した本文について質問してください"
        : "この記事の内容について質問してください";
    });
  };
  const hideSelectionChip = () => {
    if (!selectionChip) return;
    selectionChip.hidden = true;
    selectionCandidate = "";
  };
  const openPanel = (opener: HTMLButtonElement | null, focusQuestion = false) => {
    if (!articlePage || !panel || isPanelOpen()) return;
    lastOpener = opener;
    articlePage.dataset.assistantOpen = "true";
    panel.removeAttribute("inert");
    panel.setAttribute("aria-hidden", "false");
    selectionChip?.setAttribute("aria-expanded", "true");
    document.body.classList.add("has-assistant-panel");
    requestAnimationFrame(() => {
      if (focusQuestion) panel.querySelector<HTMLTextAreaElement>("[data-question]")?.focus();
      else closeButton?.focus();
    });
    dispatchAssistantOpen();
  };
  const closePanel = () => {
    if (!articlePage || !panel || !isPanelOpen()) return;
    articlePage.dataset.assistantOpen = "false";
    panel.setAttribute("inert", "");
    panel.setAttribute("aria-hidden", "true");
    selectionChip?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("has-assistant-panel");
    if (selectionChip && lastOpener === selectionChip && selectedText) {
      const chip = selectionChip;
      window.setTimeout(() => {
        if (isPanelOpen()) return;
        selectionCandidate = selectedText;
        chip.hidden = false;
        requestAnimationFrame(() => chip.focus());
      }, 260);
    } else {
      requestAnimationFrame(() => lastOpener?.focus());
    }
  };
  closeButton?.addEventListener("click", closePanel);
  selectionChip?.addEventListener("pointerdown", (event) => event.preventDefault());
  selectionChip?.addEventListener("click", () => {
    if (!selectionCandidate) return;
    selectedText = selectionCandidate;
    syncSelectionContext();
    openPanel(selectionChip, true);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isPanelOpen()) closePanel();
  });
  document.addEventListener("pointerdown", (event) => {
    const target = event.target;
    if (!isPanelOpen() || !(target instanceof Node)) return;
    if (!panel?.contains(target) && !selectionChip?.contains(target)) closePanel();
  });

  function showSelectionChip() {
    if (!selectionChip || !articleBody || isPanelOpen()) return;
    const selection = window.getSelection();
    if (!selection || selection.isCollapsed || selection.rangeCount === 0) {
      hideSelectionChip();
      return;
    }
    const range = selection.getRangeAt(0);
    if (!articleBody.contains(range.commonAncestorContainer)) {
      hideSelectionChip();
      return;
    }
    const text = selection.toString().replace(/\s+/g, " ").trim().slice(0, 1000);
    const rects = range.getClientRects();
    const anchor = rects.item(rects.length - 1) ?? range.getBoundingClientRect();
    if (text.length < 2 || (anchor.width === 0 && anchor.height === 0)) {
      hideSelectionChip();
      return;
    }
    selectionCandidate = text;
    selectionChip.hidden = false;
    requestAnimationFrame(() => {
      const chipRect = selectionChip.getBoundingClientRect();
      const centeredLeft = anchor.left + anchor.width / 2 - chipRect.width / 2;
      const left = Math.min(Math.max(8, centeredLeft), window.innerWidth - chipRect.width - 8);
      const below = anchor.bottom + 8;
      const top = below + chipRect.height <= window.innerHeight - 8
        ? below
        : Math.max(8, anchor.top - chipRect.height - 8);
      selectionChip.style.left = `${left}px`;
      selectionChip.style.top = `${top}px`;
    });
  }
  document.addEventListener("selectionchange", () => window.setTimeout(showSelectionChip, 0));
  document.addEventListener("pointerup", showSelectionChip);
  document.addEventListener("keyup", (event) => {
    if (event.key.startsWith("Arrow") || event.key === "Shift") showSelectionChip();
  });
  window.addEventListener("scroll", () => {
    if (!isPanelOpen()) hideSelectionChip();
  }, { passive: true });
  window.addEventListener("resize", hideSelectionChip);

  document.querySelectorAll<HTMLFormElement>("[data-assistant-form]").forEach((form) => {
    const questionInput = form.querySelector<HTMLTextAreaElement>("[data-question]");
    const status = form.querySelector<HTMLElement>("[data-assistant-status]");
    const answer = form.querySelector<HTMLElement>("[data-assistant-answer]");
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const clear = form.querySelector<HTMLButtonElement>("[data-clear-conversation]");
    const clearSelection = form.querySelector<HTMLButtonElement>("[data-clear-selection]");
    const conversation = form.querySelector<HTMLElement>(".assistant-conversation");
    const composerLabel = form.querySelector<HTMLLabelElement>("[data-composer-label]");
    const history: Array<{ role: "user" | "assistant"; content: string }> = [];
    let apiKey = "";

    if (!questionInput || !status || !answer || !submit) return;

    const syncComposerMode = () => {
      const enteringApiKey = !apiKey;
      questionInput.dataset.mode = enteringApiKey ? "api-key" : "question";
      questionInput.placeholder = enteringApiKey
        ? "最初にOpenAI APIキーを入力してください"
        : selectedText
          ? "選択した本文について質問してください"
          : "この記事の内容について質問してください";
      questionInput.setAttribute("aria-label", enteringApiKey ? "OpenAI APIキー" : "質問");
      submit.setAttribute("aria-label", enteringApiKey ? "APIキーを設定" : "質問を送信");
      if (composerLabel) composerLabel.textContent = enteringApiKey ? "OpenAI APIキー" : "質問";
    };

    const resizeQuestionInput = () => {
      questionInput.style.height = "auto";
      const styles = window.getComputedStyle(questionInput);
      const lineHeight = Number.parseFloat(styles.lineHeight) || 24;
      const singleLineHeight = lineHeight
        + Number.parseFloat(styles.paddingTop)
        + Number.parseFloat(styles.paddingBottom);
      questionInput.dataset.multiline = String(questionInput.scrollHeight > singleLineHeight + 1);
      questionInput.style.height = `${Math.min(questionInput.scrollHeight, 144)}px`;
    };
    questionInput.addEventListener("input", resizeQuestionInput);
    questionInput.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      form.requestSubmit();
    });
    resizeQuestionInput();
    syncComposerMode();

    clear?.addEventListener("click", () => {
      history.length = 0;
      apiKey = "";
      answer.replaceChildren();
      questionInput.value = "";
      syncComposerMode();
      resizeQuestionInput();
      status.textContent = "会話とAPIキーを消去しました。";
    });

    clearSelection?.addEventListener("click", () => {
      selectedText = "";
      window.getSelection()?.removeAllRanges();
      hideSelectionChip();
      syncSelectionContext();
      questionInput.focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = questionInput.value.trim();
      if (!apiKey && input.length < 20) {
        status.textContent = "有効なOpenAI APIキーを入力してください。";
        questionInput.focus();
        return;
      }
      if (!apiKey) {
        apiKey = input;
        questionInput.value = "";
        syncComposerMode();
        resizeQuestionInput();
        status.textContent = "APIキーを設定しました。質問を入力してください。";
        questionInput.focus();
        return;
      }
      const question = input;
      if (!question) {
        status.textContent = "質問を入力してください。";
        questionInput.focus();
        return;
      }

      status.textContent = "回答を作成しています。";
      submit.disabled = true;
      form.setAttribute("aria-busy", "true");

      const userMessage = document.createElement("div");
      userMessage.className = "assistant-message assistant-message--user";
      const userText = document.createElement("p");
      userText.textContent = question;
      userMessage.append(userText);
      answer.append(userMessage);
      conversation?.scrollTo({ top: conversation.scrollHeight, behavior: "smooth" });

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            "x-openai-api-key": apiKey
          },
          body: JSON.stringify({
            slug: articleSlug,
            question,
            history,
            ...(selectedText ? { selectedText } : {}),
            ...(previewArticle ? { preview: true } : {})
          })
        });
        const payload = await response.json();
        if (!response.ok) {
          if (response.status === 401) {
            apiKey = "";
            questionInput.value = "";
            syncComposerMode();
            resizeQuestionInput();
          }
          throw new Error(payload.error || "回答を作成できませんでした。");
        }

        const assistantMessage = document.createElement("div");
        assistantMessage.className = "assistant-message assistant-message--assistant";
        const paragraph = document.createElement("p");
        paragraph.textContent = payload.answer;
        assistantMessage.append(paragraph);
        if (Array.isArray(payload.references) && payload.references.length > 0) {
          const referenceHeading = document.createElement("h4");
          referenceHeading.textContent = "読み返す場所";
          const referenceList = document.createElement("ul");
          payload.references.forEach((reference: unknown) => {
            if (!reference || typeof reference !== "object") return;
            const id = (reference as { id?: unknown }).id;
            const text = (reference as { text?: unknown }).text;
            if (typeof id !== "string" || typeof text !== "string") return;
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.href = `#${encodeURIComponent(id)}`;
            link.textContent = text;
            item.append(link);
            referenceList.append(item);
          });
          if (referenceList.childElementCount > 0) assistantMessage.append(referenceHeading, referenceList);
        }
        answer.append(assistantMessage);
        conversation?.scrollTo({ top: conversation.scrollHeight, behavior: "smooth" });
        history.push({ role: "user", content: question }, { role: "assistant", content: payload.answer });
        if (history.length > 6) history.splice(0, history.length - 6);
        questionInput.value = "";
        resizeQuestionInput();
        status.textContent = "回答を表示しました。";
        document.dispatchEvent(new CustomEvent("noema:analytics", {
          detail: { eventType: "assistant_success" }
        }));
      } catch (error) {
        userMessage.remove();
        status.textContent = error instanceof Error ? error.message : "回答を作成できませんでした。";
        if (!apiKey) questionInput.focus();
        document.dispatchEvent(new CustomEvent("noema:analytics", {
          detail: { eventType: "assistant_error" }
        }));
      } finally {
        submit.disabled = false;
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
