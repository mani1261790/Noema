---
import type { CmsPublishedSeries } from "../lib/cms-publication-repository";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  series: CmsPublishedSeries;
  headingLevel?: 2 | 3;
}

const { series, headingLevel = 3 } = Astro.props;
const firstArticle = series.items[0];
---

<article class="series-card">
  <div class="series-card__body">
    {headingLevel === 2
      ? <h2 class="series-card__title">{series.title}</h2>
      : <h3 class="series-card__title">{series.title}</h3>}
    <p class="series-card__description">{series.description}</p>
  </div>
  <div class="series-card__actions">
    {firstArticle && <a class="series-card__primary" href={firstArticle.href}>1本目の記事を読む <span class="dads-card-arrow" aria-hidden="true"><ArrowIcon /></span></a>}
    <a class="series-card__overview dads-link" href={series.href} aria-label={`${series.title}：全${series.items.length}本の目次を見る`}>全{series.items.length}本の目次を見る</a>
  </div>
</article>
