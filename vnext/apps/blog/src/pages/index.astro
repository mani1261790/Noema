---
import { learningPaths, previewArticles, topicLabels } from "@noema/content";
import ArticleRow from "../components/ArticleRow.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import HeroGraphic from "../components/HeroGraphic.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
const showPreview = import.meta.env.DEV || import.meta.env.NOEMA_PREVIEW_CONTENT === "1";
const articles = showPreview ? previewArticles : [];
---

<BaseLayout>
  <section class="home-hero">
    <div class="noema-container home-hero__inner">
      <div class="home-hero__copy">
        <h1>AIを、使うところから仕組みまで。</h1>
        <p>まず試して、日々に取り入れ、作る・理解するへ。<br />Noemaは、自分の興味から学び続けるための教材サービスです。</p>
        <a class="dads-button" data-size="lg" data-type="solid-fill" href="/articles">
          記事を探す
          <ArrowIcon />
        </a>
      </div>
      <div class="home-hero__visual"><HeroGraphic /></div>
    </div>
  </section>

  <section id="learning-paths" class="learning-paths" aria-labelledby="learning-paths-heading">
    <div class="noema-container">
      <header class="learning-paths__heading">
        <h2 id="learning-paths-heading" class="noema-section-heading">学び方を選ぶ</h2>
        <p>最初の二つは共通の入口です。その先は、作ることと理解することのどちらからでも進めます。</p>
      </header>
      <div class="learning-paths__layout">
        <section aria-labelledby="common-path-heading">
          <h3 id="common-path-heading">共通のステップ</h3>
          <ol class="learning-paths__list learning-paths__list--common">
            {learningPaths.slice(0, 2).map((path) => (
              <li>
                <article class="learning-path-card">
                  <span>{path.eyebrow}</span>
                  <strong>{path.title}</strong>
                  <p>{path.description}</p>
                  <a class="learning-path-card__link" href={path.href}>記事を見る <ArrowIcon /></a>
                </article>
              </li>
            ))}
          </ol>
        </section>
        <section class="learning-paths__advanced" aria-labelledby="advanced-path-heading">
          <h3 id="advanced-path-heading">興味に合わせて選ぶ発展トラック</h3>
          <div class="learning-paths__list learning-paths__list--advanced">
            {learningPaths.slice(2).map((path) => (
              <article class="learning-path-card">
                <span>{path.eyebrow}</span>
                <strong>{path.title}</strong>
                <p>{path.description}</p>
                <a class="learning-path-card__link" href={path.href}>記事を見る <ArrowIcon /></a>
              </article>
            ))}
          </div>
          <p class="learning-paths__cross-note">両方を学びたい場合は、開発から理論へ進み、関連記事で相互に行き来できます。</p>
        </section>
      </div>
    </div>
  </section>

  <section class="home-articles" aria-labelledby="latest-heading">
    <div class="noema-container">
      <h2 id="latest-heading" class="noema-section-heading">新着記事</h2>
      {articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article) => <ArticleRow article={article} />)}
          <p class="preview-notice">表示中の記事はUI確認用fixtureです。公開コンテンツには含まれません。</p>
        </div>
      ) : (
        <div class="noema-empty-state">
          <h3>記事を準備しています</h3>
          <p>人の手で丁寧に執筆した記事を、順次公開します。</p>
        </div>
      )}
    </div>
  </section>

  <section class="topic-band" aria-labelledby="topic-heading">
    <div class="noema-container">
      <h2 id="topic-heading" class="noema-section-heading">テーマから探す</h2>
      <ul class="topic-band__links">
        {Object.entries(topicLabels).map(([slug, label]) => (
          <li><a href={`/topics/${slug}`}>{label}<ArrowIcon /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-about" aria-labelledby="first-heading">
    <div class="noema-container home-about__inner">
      <div>
        <h2 id="first-heading" class="noema-section-heading">はじめての方へ</h2>
        <p>Noemaは、AIを自分の興味から学び続けるための教材サービスです。専門用語を隠さず、まず日常の言葉と具体例から説明します。</p>
        <a href="/about">Noemaについて詳しく見る <ArrowIcon /></a>
      </div>
      <svg class="home-about__book" viewBox="0 0 220 130" role="img" aria-label="開かれた本の線画">
        <path d="M110 110c-25-18-51-25-82-19V22c31-6 57 1 82 19v69Zm0 0c25-18 51-25 82-19V22c-31-6-57 1-82 19v69Z" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M48 44c17-1 31 3 45 11M48 60c17-1 31 3 45 11M127 55c14-8 28-12 45-11M127 71c14-8 28-12 45-11" fill="none" stroke="currentColor" />
      </svg>
    </div>
  </section>
</BaseLayout>
