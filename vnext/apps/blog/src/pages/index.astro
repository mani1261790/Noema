---
import ArticleRow from "../components/ArticleRow.astro";
import RecentArticleList from "../components/RecentArticleList.astro";
import SeriesCard from "../components/SeriesCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortArticlesByDate } from "../lib/articles";
import { selectEntryArticles, readingIntents, articleIntent } from "../lib/article-discovery";
import { listPublicArticleSummaries, listPublishedSeries } from "../lib/cms-publications";
import { canonicalUrl, organizationJsonLd, websiteJsonLd } from "../lib/seo";
import { listNarrowingTopics } from "../lib/topics";

const [articles, seriesList] = await Promise.all([listPublicArticleSummaries(), listPublishedSeries()]);
const startArticles = selectEntryArticles(articles, seriesList);
const startArticleSlugs = new Set(startArticles.map((article) => article.slug));
const recentArticles = sortArticlesByDate(articles)
  .filter((article) => !startArticleSlugs.has(article.slug)).slice(0, 5);
const intentCounts = Object.entries(readingIntents).map(([id, intent]) => ({ id, ...intent, count: articles.filter((article) => articleIntent(article) === id).length })).filter((intent) => intent.count > 0);
const mobileIntents = [
  { id: "try", description: "AIや道具に、まず触れてみる" },
  { id: "explore", description: "身近な疑問から、内側へ" },
  { id: "build", description: "コードや画面を、自分の手で" }
].flatMap((entry) => {
  const intent = intentCounts.find((intent) => intent.id === entry.id);
  return intent ? [{ ...intent, description: entry.description }] : [];
});
const narrowingTopics = listNarrowingTopics(articles);
const title = "AIでできることと、その仕組みを学ぶ | Noema";
const description = "コーディングエージェントやローカルLLMなど、AIでできることと、その仕組みを、初めての人にもわかる具体例から解説する技術メディアです。";
const siteUrl = canonicalUrl("/", Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizationJsonLd(Astro.site),
    {
      ...websiteJsonLd(Astro.site),
      description,
      inLanguage: "ja",
      publisher: { "@id": `${siteUrl}#organization` }
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="noema-container home-hero__inner">
      <div class="home-hero__copy">
        <h1 id="hero-heading">「できた」の先に、<br />なぜがある。</h1>
        <p>まずは使ってみる。気になったら、仕組みまで。</p>
      </div>
      <div class="home-hero__illustration" aria-hidden="true">
        <img src="/images/brand/noema-curiosity-hero.webp" alt="" width="1800" height="1021" fetchpriority="high" />
      </div>
      {mobileIntents.length > 0 && (
        <nav class="home-hero__mobile-entry" aria-labelledby="mobile-intent-heading">
          <h2 id="mobile-intent-heading">今日は、何を読もう。</h2>
          <p>いま気になることから選べます。</p>
          <ul>
            {mobileIntents.map((intent) => (
              <li><a href={`/articles?intent=${intent.id}`}>
                <span><strong>{intent.label}</strong><small>{intent.description}</small></span>
                <span aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>

  {startArticles.length > 0 && (
    <section class="home-start" aria-labelledby="start-heading">
      <div class="noema-container">
        <div class="section-heading-row">
          <h2 id="start-heading" class="noema-section-heading">気になる1本から</h2>
          <a class="dads-link" href="/articles">すべての記事を見る</a>
        </div>
        <div class="article-list home-start__articles">
          {startArticles.map((article) => <ArticleRow article={article} headingLevel={3} reason={readingIntents[articleIntent(article)].label} />)}
        </div>
      </div>
    </section>
  )}

  {recentArticles.length > 0 && (
    <section class="home-recent" aria-labelledby="recent-heading">
      <div class="noema-container">
        <div class="section-heading-row">
          <h2 id="recent-heading" class="noema-section-heading">新着記事</h2>
          <a class="dads-link" href="/articles">すべての記事を見る</a>
        </div>
        <RecentArticleList articles={recentArticles} />
      </div>
    </section>
  )}

  {intentCounts.length > 0 && (
    <section class="home-intents" aria-labelledby="intent-heading">
      <div class="noema-container">
        <h2 id="intent-heading" class="noema-section-heading">今日は、何を読もう。</h2>
        <div class="reading-intents">{intentCounts.map((intent) => <a href={`/articles?intent=${intent.id}`}><span>{intent.label}</span><p>{intent.description}</p><small>{intent.count}本の一覧を見る →</small></a>)}</div>
      </div>
    </section>
  )}

  {seriesList.length > 0 && (
    <section class="home-series" aria-labelledby="series-heading">
      <div class="noema-container">
        <div class="section-heading-row">
          <h2 id="series-heading" class="noema-section-heading">シリーズから読む</h2>
          <a class="dads-link" href="/series">すべてのシリーズを見る</a>
        </div>
        <p class="home-series__lead">ひとつのテーマを、記事をたどりながら少しずつ深められます。</p>
        <div class="series-grid series-grid--home">{seriesList.slice(0, 3).map((series) => <SeriesCard series={series} />)}</div>
      </div>
    </section>
  )}

  {articles.length === 0 && seriesList.length === 0 && (
    <section class="home-empty" aria-labelledby="empty-heading">
      <div class="noema-container noema-empty-state">
        <h2 id="empty-heading">記事はまだありません</h2>
      </div>
    </section>
  )}

  {narrowingTopics.length > 0 && (
    <section class="home-topics" aria-labelledby="topic-heading">
      <div class="noema-container">
        <h2 id="topic-heading" class="noema-section-heading">テーマから探す</h2>
        <p class="home-topics__lead">関心のあるテーマから、いま読める記事をたどれます。</p>
        <ul class="home-topic-list">
          {narrowingTopics.map((topic) => (
            <li>
              <div class="home-topic-list__heading">
                <h3><a class="dads-link" href={`/topics/${topic.slug}`}>{topic.label}<span class="navigation-link-action">記事一覧を見る →</span></a></h3>
                <p>{topic.articleCount}件の記事</p>
              </div>
              <p class="home-topic-list__description">{topic.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="home-discovery" aria-labelledby="discovery-heading">
    <div class="noema-container">
      <h2 id="discovery-heading" class="noema-section-heading">気になる言葉から探す</h2>
      <p>記事名や執筆者、テーマに加えて、コードや手計算のある記事も探せます。</p>
      <a class="dads-link" href="/articles#search">記事を探す</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero__mobile-entry { display: none; }
  @media (max-width: 40rem) {
    .home-hero__inner { gap: 0; padding-block: 1.375rem 1.875rem; }
    .home-hero__copy h1 { font-size: 1.75rem; line-height: 1.5; }
    .home-hero__copy p { margin-top: .75rem; font-size: .875rem; line-height: 1.9; letter-spacing: 0; }
    .home-hero__illustration { display: block; max-width: none; margin: .75rem -1.5rem 1.25rem; }
    .home-hero__illustration img { width: 100%; height: 11.25rem; object-fit: contain; mask-image: none; -webkit-mask-image: none; }
    .home-hero__mobile-entry { display: block; min-width: 0; }
    .home-hero__mobile-entry h2 { margin: 0 0 .375rem; font-size: 1.25rem; line-height: 1.5; }
    .home-hero__mobile-entry > p { margin: 0 0 1rem; font-size: .8125rem; line-height: 1.8; color: var(--color-neutral-solid-gray-600); }
    .home-hero__mobile-entry ul { display: grid; gap: .5625rem; margin: 0; padding: 0; list-style: none; }
    .home-hero__mobile-entry a { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 4.375rem; padding: .75rem 1rem; border: 1px solid var(--noema-border); border-radius: .75rem; background: #ffffffa6; color: var(--color-key-900); text-decoration: none; }
    .home-hero__mobile-entry a > span:first-child { min-width: 0; }
    .home-hero__mobile-entry strong { display: block; font-size: 1rem; font-weight: 600; line-height: 1.5; }
    .home-hero__mobile-entry small { display: block; margin-top: .1875rem; font-size: .75rem; line-height: 1.5; color: var(--color-neutral-solid-gray-600); }
    .home-hero__mobile-entry a:hover { background: var(--color-key-50); }
    .home-hero__mobile-entry a:focus-visible { outline: 3px solid var(--color-key-800); outline-offset: 3px; }
    .home-intents { display: none; }
    .home-start { border-top: 1px solid var(--noema-border); }
    .home-start .section-heading-row { display: flex; align-items: center; justify-content: space-between; gap: .625rem; margin-bottom: 1.125rem; }
    .home-start .section-heading-row h2 { margin: 0; font-size: 1.3125rem; line-height: 1.5; }
    .home-start .section-heading-row a { margin: 0; font-size: .75rem; white-space: nowrap; }
  }
  @media (max-width: 22rem) {
    .home-hero__copy h1 { font-size: 1.5625rem; }
    .home-start .section-heading-row h2 { font-size: 1.1875rem; }
    .home-start .section-heading-row a { font-size: .6875rem; }
  }
</style>
