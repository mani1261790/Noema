---
import { previewArticles, topicLabels } from "@noema/content";
import ArrowIcon from "../components/ArrowIcon.astro";
import FeaturedArticleCard from "../components/FeaturedArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
const showPreview = import.meta.env.DEV || import.meta.env.NOEMA_PREVIEW_CONTENT === "1";
const articles = showPreview ? previewArticles : [];
---

<BaseLayout>
  <section class="home-hero">
    <div class="noema-container home-hero__inner">
      <div class="home-hero__copy">
        <h1>なんとなく気になる、から。</h1>
        <p>AIでできること、その裏側で起きていること。<br />難しい技術の面白さを、直感と具体例からひもときます。</p>
        <a class="dads-button" data-size="lg" data-type="solid-fill" href="/articles">
          記事を読む
          <ArrowIcon />
        </a>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section id="featured-articles" class="home-featured" aria-labelledby="featured-heading">
      <div class="noema-container">
        <h2 id="featured-heading" class="noema-section-heading">注目の記事</h2>
        <div class="featured-article-grid">
          {articles.slice(0, 4).map((article) => <FeaturedArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <section id="topics" class="topic-band" aria-labelledby="topic-heading">
    <div class="noema-container">
      <h2 id="topic-heading" class="noema-section-heading">テーマから探す</h2>
      <ul class="topic-band__links">
        {Object.entries(topicLabels).map(([slug, label]) => (
          <li><a class="topic-band__link" href={`/topics/${slug}`}>{label}<span class="dads-section-arrow" aria-hidden="true"><ArrowIcon /></span></a></li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
