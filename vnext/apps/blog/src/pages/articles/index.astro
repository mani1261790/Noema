---
import { previewArticles, topicLabels } from "@noema/content";
import ArticleRow from "../../components/ArticleRow.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;
const showPreview = import.meta.env.DEV || import.meta.env.NOEMA_PREVIEW_CONTENT === "1";
const articles = showPreview ? previewArticles : [];
---

<BaseLayout title="記事を読む | Noema" description="気になる言葉やテーマから、Noemaの記事を探せます。">
  <div class="noema-container listing-page">
    <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "記事を読む" }]} />
    <header class="page-heading">
      <h1>記事を読む</h1>
      <p>気になる言葉やテーマから記事を探せます。</p>
    </header>

    <form id="search" class="article-search" role="search">
      <div class="dads-form-control-label" data-size="md">
        <label class="dads-form-control-label__label" for="article-keyword">キーワード</label>
        <input class="dads-input-text__input" data-size="md" id="article-keyword" name="keyword" type="search" placeholder="記事タイトルや概要を検索" />
      </div>
      <div class="dads-form-control-label" data-size="md">
        <label class="dads-form-control-label__label" for="article-topic">テーマ</label>
        <select id="article-topic" name="topic">
          <option value="">すべてのテーマ</option>
          {Object.entries(topicLabels).map(([slug, label]) => <option value={slug}>{label}</option>)}
        </select>
      </div>
      <button class="dads-button" data-size="md" data-type="solid-fill" type="submit">絞り込む</button>
      <button class="dads-button article-search__reset" data-size="md" data-type="outline" type="button" data-reset-search>条件を解除</button>
    </form>

    <div class="article-search__active" data-active-filters hidden>
      <span>選択中の条件</span>
      <ul data-active-filter-list></ul>
    </div>
    <p class="article-count" data-article-count role="status" aria-live="polite">{articles.length}件の記事</p>
    <div class="article-list" data-article-list>
      {articles.map((article) => (
        <div
          data-article-item
          data-title={`${article.title} ${article.description} ${article.tags.join(" ")}`}
          data-topic={article.topics.join(" ")}
        >
          <ArticleRow article={article} />
        </div>
      ))}
    </div>
    <div class="noema-empty-state" data-empty-state hidden={articles.length > 0}>
      <h2>{articles.length > 0 ? "該当する記事はありません" : "記事はまだありません"}</h2>
      {articles.length > 0 && <p>条件を解除するか、別の言葉やテーマをお試しください。</p>}
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".article-search");
  const keyword = document.querySelector<HTMLInputElement>("#article-keyword");
  const topic = document.querySelector<HTMLSelectElement>("#article-topic");
  const items = [...document.querySelectorAll<HTMLElement>("[data-article-item]")];
  const count = document.querySelector<HTMLElement>("[data-article-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");
  const reset = document.querySelector<HTMLButtonElement>("[data-reset-search]");
  const activeFilters = document.querySelector<HTMLElement>("[data-active-filters]");
  const activeFilterList = document.querySelector<HTMLUListElement>("[data-active-filter-list]");

  const applyFilters = (updateUrl = true) => {
    const query = keyword?.value.trim().toLocaleLowerCase("ja") ?? "";
    const selectedTopic = topic?.value ?? "";
    let visible = 0;
    for (const item of items) {
      const matchesText = !query || (item.dataset.title ?? "").toLocaleLowerCase("ja").includes(query);
      const matchesTopic = !selectedTopic || (item.dataset.topic ?? "").split(" ").includes(selectedTopic);
      item.hidden = !(matchesText && matchesTopic);
      if (!item.hidden) visible += 1;
    }
    if (count) count.textContent = `${visible}件の記事`;
    if (empty) empty.hidden = visible > 0;
    if (activeFilters && activeFilterList) {
      activeFilterList.replaceChildren();
      const filters = [
        ...(query ? [`キーワード: ${keyword?.value.trim()}`] : []),
        ...(selectedTopic && topic ? [`テーマ: ${topic.options[topic.selectedIndex]?.text ?? selectedTopic}`] : [])
      ];
      for (const filter of filters) {
        const item = document.createElement("li");
        item.textContent = filter;
        activeFilterList.append(item);
      }
      activeFilters.hidden = filters.length === 0;
    }
    if (updateUrl) {
      const params = new URLSearchParams();
      if (keyword?.value.trim()) params.set("keyword", keyword.value.trim());
      if (topic?.value) params.set("topic", topic.value);
      window.history.replaceState(null, "", `${window.location.pathname}${params.size ? `?${params}` : ""}#search`);
    }
  };

  const initialParams = new URLSearchParams(window.location.search);
  if (keyword) keyword.value = initialParams.get("keyword") ?? "";
  if (topic) topic.value = initialParams.get("topic") ?? "";
  applyFilters(false);

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    applyFilters();
  });
  keyword?.addEventListener("input", () => applyFilters());
  topic?.addEventListener("change", () => applyFilters());
  reset?.addEventListener("click", () => {
    if (keyword) keyword.value = "";
    if (topic) topic.value = "";
    applyFilters();
    keyword?.focus();
  });
</script>
