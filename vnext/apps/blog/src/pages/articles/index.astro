---
import { articleFeatureLabels, type ArticleFeature } from "@noema/content/article-features";
import { articleIntent, readingIntents } from "../../lib/article-discovery";
import { topicLabels } from "@noema/content";
import ReaderChoice from "../../components/ReaderChoice.astro";
import SearchClear from "../../components/SearchClear.astro";
import ArticleGuide from "../../components/ArticleGuide.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildArticleSearchText, searchArticles } from "../../lib/article-search";
import { sortArticlesByDate } from "../../lib/articles";
import { listPublicArticleSummaries, listPublishedSeries } from "../../lib/cms-publications";
import { collectionPageJsonLd } from "../../lib/seo";
import { listNarrowingTopics } from "../../lib/topics";

const [articleResults, seriesList] = await Promise.all([listPublicArticleSummaries(), listPublishedSeries()]);
const articles = sortArticlesByDate(articleResults);
const articleSeries = new Map(seriesList.flatMap((series) => series.items.map((article) => [article.slug, {
  slug: series.slug,
  title: series.title,
}] as const)));
const narrowingTopics = listNarrowingTopics(articles);
const tags = [...new Set(articles.flatMap((article) => article.tags))].sort((a, b) => a.localeCompare(b, "ja"));
const availableFeatures = (Object.keys(articleFeatureLabels) as ArticleFeature[]).filter((feature) => articles.some((article) => article.features?.includes(feature)));
const searchDocuments = articles.map((article) => ({
  slug: article.slug, title: article.title,
  text: buildArticleSearchText({ ...article, seriesTitle: articleSeries.get(article.slug)?.title, topicLabels: article.topics.map((topic) => topicLabels[topic]) }),
  series: articleSeries.get(article.slug)?.slug ?? "", topics: article.topics, tags: article.tags,
  features: article.features ?? [], intent: articleIntent(article), publishedAt: article.publishedAt ?? article.updatedAt, updatedAt: article.updatedAt,
}));
const params = Astro.url.searchParams;
const filtered = searchArticles(searchDocuments, params);
const pageSize = 12;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const currentPage = Math.max(1, Math.min(totalPages, Number.parseInt(params.get("page") ?? "1", 10) || 1));
const visibleSlugs = new Set(filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize).map((item) => item.slug));
const orderedArticles = [...filtered.map((item) => articles.find((article) => article.slug === item.slug)!), ...articles.filter((article) => !filtered.some((item) => item.slug === article.slug))];
const title = "AI駆動開発・ローカルLLMの記事を探す | Noema";
const description = "AI駆動開発、コーディングエージェント、ローカルLLMなど、Noemaで公開している技術記事を、タイトル・執筆者・概要・シリーズ・テーマ・タグから探せます。";
const jsonLd = collectionPageJsonLd({
  description,
  items: articles.map((article) => ({ name: article.title, pathname: article.href })),
  name: "記事を探す",
  pathname: "/articles",
}, Astro.site);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="noema-container listing-page">
    <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "記事を探す" }]} />
    <header class="page-heading">
      <h1>記事を探す</h1>
      <p>気になる言葉や、読みたい形から選べます。</p>
    </header>

    <form id="search" class="article-search" role="search">
      <div class="article-search__primary">
        <div class="article-search__input reader-search-field">
          <svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" fill="currentColor" />
          </svg>
          <label class="noema-visually-hidden" for="article-keyword">記事を検索</label>
          <input class="dads-input-text__input" data-size="sm" placeholder="記事名・執筆者で検索" id="article-keyword" name="keyword" type="text" role="searchbox" inputmode="search" enterkeyhint="search" spellcheck="false" autocapitalize="none" value={params.get("keyword") ?? ""} autocomplete="off" />
          <SearchClear />
        </div>
        <button class="dads-button" data-size="sm" data-type="outline" type="submit" data-search-submit>検索</button>
      </div>
      {availableFeatures.length > 0 && <fieldset class="search-features"><legend>記事の特徴</legend>{availableFeatures.map((feature) => <label><input type="checkbox" name="feature" value={feature} checked={params.getAll("feature").includes(feature)} /><span>{articleFeatureLabels[feature]}</span></label>)}</fieldset>}
      <details open={Boolean(params.get("intent") || params.get("series") || params.get("topic") || params.get("tag"))} class="article-search__detail dads-disclosure" data-filter-details>
        <summary class="dads-disclosure__summary">
          <svg class="dads-disclosure__icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          読み方・シリーズ・テーマで絞り込む
        </summary>
        <div class="article-search__detail-content dads-disclosure__content">
          <div class="article-search__filters">
            <ReaderChoice name="intent" label="読み方" value={params.get("intent")} options={[{value: "", label: "すべて"}, ...Object.entries(readingIntents).map(([value, intent]) => ({value, label: intent.label}))]} />
            <ReaderChoice name="series" label="シリーズ" value={params.get("series")} options={[{value: "", label: "すべてのシリーズ"}, ...seriesList.map((series) => ({value: series.slug, label: series.title}))]} />
            <ReaderChoice name="topic" label="テーマ" value={params.get("topic")} options={[{value: "", label: "すべてのテーマ"}, ...narrowingTopics.map((topic) => ({value: topic.slug, label: `${topic.label}（${topic.articleCount}）`}))]} />
            <ReaderChoice name="tag" label="タグ" value={params.get("tag")} options={[{value: "", label: "すべてのタグ"}, ...tags.map((tag) => ({value: tag, label: tag}))]} />
          </div>
          <div class="article-search__detail-actions">
            <button class="dads-button" data-size="md" data-type="solid-fill" type="submit">この条件で絞り込む</button>
            <button class="dads-button article-search__reset" data-size="sm" data-type="text" type="button" data-reset-search>検索条件をクリア</button>
          </div>
        </div>
      </details>
    </form>

    <div class="article-search__active" data-active-filters hidden>
      <span>選択中の条件</span>
      <ul data-active-filter-list></ul>
    </div>
    <ArticleGuide />
    <div class="article-results-bar">
    <p class="article-count" data-article-count role="status" aria-live="polite" tabindex="-1">{filtered.length}件の記事</p>
    <div class="article-sort"><span aria-hidden="true">並び順</span><ReaderChoice compact name="sort" label="並び順" form="search" value={params.get("sort") ?? "relevance"} options={[{value: "relevance", label: "関連度順"}, {value: "published", label: "新着順"}, {value: "updated", label: "更新順"}]} /></div>
    </div>
    <div class="article-list" data-article-list>
      {orderedArticles.map((article) => {
        const document = searchDocuments.find((item) => item.slug === article.slug)!;
        return <div data-article-item data-search-document={JSON.stringify(document)} hidden={!visibleSlugs.has(article.slug)}><ArticleRow article={article} /></div>;
      })}
    </div>
    <nav class="article-pagination" data-pagination aria-label="記事一覧のページ" hidden>
      <button type="button" data-page-previous>前のページ</button>
      <ol data-pagination-pages></ol>
      <button type="button" data-page-next>次のページ</button>
    </nav>
    <noscript>{totalPages > 1 && <nav class="article-pagination" aria-label="記事一覧のページ">{Array.from({length: totalPages}, (_, index) => { const target = new URLSearchParams(params); target.set("page", String(index + 1)); return <a href={`?${target}`} aria-current={currentPage === index + 1 ? "page" : undefined}>{index + 1}</a>; })}</nav>}</noscript>
    <div class="noema-empty-state" data-empty-state hidden={filtered.length > 0}>
      <h2>{articles.length > 0 ? "該当する記事はありません" : "記事はまだありません"}</h2>
      {articles.length > 0 && <p>条件を解除するか、別の言葉やテーマをお試しください。</p>}
    </div>
  </div>
</BaseLayout>

<script>
  import { searchArticles, type SearchableArticle } from "../../lib/article-search";

  const form = document.querySelector<HTMLFormElement>("#search")!;
  const list = document.querySelector<HTMLElement>("[data-article-list]")!;
  const items = [...list.querySelectorAll<HTMLElement>("[data-article-item]")].map((element) => ({
    ...JSON.parse(element.dataset.searchDocument!) as SearchableArticle, element,
  }));
  const count = document.querySelector<HTMLElement>("[data-article-count]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty-state]")!;
  const active = document.querySelector<HTMLElement>("[data-active-filters]")!;
  const activeList = document.querySelector<HTMLElement>("[data-active-filter-list]")!;
  const pagination = document.querySelector<HTMLElement>("[data-pagination]")!;
  const pageList = document.querySelector<HTMLElement>("[data-pagination-pages]")!;
  const previous = document.querySelector<HTMLButtonElement>("[data-page-previous]")!;
  const next = document.querySelector<HTMLButtonElement>("[data-page-next]")!;
  const details = document.querySelector<HTMLDetailsElement>("[data-filter-details]")!;
  const pageSize = 12;
  let page = 1;
  const readParams = () => {
    const params = new URLSearchParams();
    new FormData(form).forEach((value, key) => {
      if (typeof value === "string" && value.trim() && !(key === "sort" && value === "relevance")) params.append(key, value.trim());
    });
    return params;
  };
  const apply = (history: boolean | "replace" = true, restoredParams?: URLSearchParams) => {
    cancelInput();
    const params = restoredParams ?? readParams();
    const filtered = searchArticles(items, params);
    const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
    page = Math.max(1, Math.min(page, pages));
    items.forEach(({ element }) => { element.hidden = true; });
    filtered.forEach(({ element }, index) => {
      element.hidden = index < (page - 1) * pageSize || index >= page * pageSize;
      list.append(element);
    });
    count.textContent = `${filtered.length}件の記事${pages > 1 ? `（${page}/${pages}ページ）` : ""}`;
    empty.hidden = filtered.length > 0;
    activeList.replaceChildren();
    params.forEach((value, name) => {
      if (name === "sort" || name === "feature") return;
      const control = form.elements.namedItem(name);
      let label = value;
      if (control instanceof RadioNodeList) {
        const selected = [...control].find((node) => node instanceof HTMLInputElement && node.checked) as HTMLInputElement | undefined;
        label = selected?.dataset.choiceLabel ?? value;
      }
      if (name === "feature") label = [...form.querySelectorAll<HTMLInputElement>('input[name="feature"]')].find((input) => input.value === value)?.nextElementSibling?.textContent ?? value;
      const li = document.createElement("li"); li.textContent = label; activeList.append(li);
    });
    active.hidden = !activeList.children.length;
    pagination.hidden = pages <= 1;
    previous.disabled = page === 1; next.disabled = page === pages;
    pageList.replaceChildren();
    for (let n = Math.max(1, Math.min(page - 2, pages - 4)); n <= Math.min(pages, Math.max(5, page + 2)); n++) {
      const li = document.createElement("li"); const button = document.createElement("button");
      button.type = "button"; button.textContent = String(n); button.dataset.page = String(n);
      button.setAttribute("aria-label", `${n}ページ目`);
      if (n === page) button.setAttribute("aria-current", "page");
      li.append(button); pageList.append(li);
    }
    if (page > 1) params.set("page", String(page));
    document.dispatchEvent(new Event("reader-controls-sync"));
    if (history) window.history[history === "replace" ? "replaceState" : "pushState"](null, "", `${location.pathname}${params.size ? `?${params}` : ""}`);
  };
  const keyword = form.querySelector<HTMLInputElement>("#article-keyword")!;
  let composing = false;
  let inputTimer: ReturnType<typeof setTimeout> | undefined;
  const cancelInput = () => { clearTimeout(inputTimer); };
  const scheduleInput = () => {
    cancelInput();
    if (composing) return;
    inputTimer = setTimeout(() => { page = 1; apply("replace"); }, 200);
  };
  keyword.addEventListener("compositionstart", () => { composing = true; cancelInput(); });
  keyword.addEventListener("compositionend", () => { composing = false; scheduleInput(); });
  keyword.addEventListener("input", (event) => {
    if (!(event instanceof InputEvent && event.isComposing)) scheduleInput();
  });
  form.querySelector<HTMLElement>("[data-search-submit]")!.hidden = true;
  form.dataset.liveSearch = "true";
  const restore = () => {
    cancelInput();
    const params = new URLSearchParams(location.search);
    for (const control of [...form.elements]) {
      if (control instanceof HTMLInputElement) {
        if (control.type === "checkbox") control.checked = params.getAll(control.name).includes(control.value);
        else if (control.type === "radio") control.checked = control.value === (params.get(control.name) ?? (control.name === "sort" ? "relevance" : ""));
        else control.value = params.get(control.name) ?? "";
      } else if (control instanceof HTMLSelectElement) control.value = params.get(control.name) ?? (control.name === "sort" ? "relevance" : "");
    }
    details.open = ["intent", "series", "topic", "tag"].some((name) => Boolean(params.get(name)));
    page = Number.parseInt(params.get("page") ?? "1", 10) || 1;
    apply(false, params);
  };
  form.addEventListener("submit", (event) => { event.preventDefault(); cancelInput(); if (!composing) { page = 1; apply("replace"); } });
  form.addEventListener("change", (event) => {
    if (event.target instanceof HTMLSelectElement || (event.target instanceof HTMLInputElement && ["checkbox", "radio"].includes(event.target.type))) { page = 1; apply(); }
  });
  document.querySelector('.article-sort')?.addEventListener("change", () => { page = 1; apply(); });
  form.querySelector("[data-reset-search]")?.addEventListener("click", () => {
    for (const control of [...form.elements]) {
      if (control instanceof HTMLInputElement) { if (control.type === "checkbox") control.checked = false; else if (control.type === "radio") control.checked = control.value === (control.name === "sort" ? "relevance" : ""); else control.value = ""; }
      else if (control instanceof HTMLSelectElement) control.value = control.name === "sort" ? "relevance" : "";
    }
    page = 1; apply(); document.querySelector<HTMLInputElement>("#article-keyword")?.focus();
  });
  previous.addEventListener("click", () => { page--; apply(); count.focus(); });
  next.addEventListener("click", () => { page++; apply(); count.focus(); });
  pageList.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-page]");
    if (button) { page = Number(button.dataset.page); apply(); count.focus(); }
  });
  window.addEventListener("popstate", restore);
  restore();
</script>
