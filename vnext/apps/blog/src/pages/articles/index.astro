---
import { topicLabels } from "@noema/content";
import ArticleRow from "../../components/ArticleRow.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortArticlesByDate } from "../../lib/articles";
import { listPublicArticleSummaries, listPublishedSeries } from "../../lib/cms-publications";

const [articleResults, seriesList] = await Promise.all([listPublicArticleSummaries(), listPublishedSeries()]);
const articles = sortArticlesByDate(articleResults);
const articleSeries = new Map(seriesList.flatMap((series) => series.items.map((article) => [article.slug, series.slug] as const)));
const tags = [...new Set(articles.flatMap((article) => article.tags))].sort((a, b) => a.localeCompare(b, "ja"));
const suggestions = [...new Set([...articles.map((article) => article.title), ...tags])];
---

<BaseLayout title="記事を読む | Noema" description="気になる言葉やテーマから、Noemaの記事を探せます。">
  <div class="noema-container listing-page">
    <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "記事を読む" }]} />
    <header class="page-heading">
      <h1>記事を読む</h1>
      <p>気になる言葉やテーマから記事を探せます。</p>
    </header>

    <form id="search" class="article-search" role="search">
      <div class="article-search__primary">
        <label class="article-search__input">
          <svg class="noema-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" fill="currentColor" />
          </svg>
          <span class="noema-visually-hidden">記事を検索</span>
          <input class="dads-input-text__input" data-size="md" id="article-keyword" name="keyword" type="search" list="article-search-suggestions" aria-describedby="article-search-support" autocomplete="off" />
        </label>
        <datalist id="article-search-suggestions">
          {suggestions.map((suggestion) => <option value={suggestion}></option>)}
        </datalist>
        <button class="dads-button" data-size="md" data-type="solid-fill" type="submit">検索</button>
      </div>
      <p id="article-search-support" class="article-search__support">タイトル、概要、タグから検索できます。</p>
      <details class="article-search__detail dads-disclosure" data-filter-details>
        <summary class="dads-disclosure__summary">
          <svg class="dads-disclosure__icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="11" fill="currentColor" />
            <circle class="dads-disclosure__icon-circle" cx="12" cy="12" r="8" fill="currentColor" />
            <path class="dads-disclosure__icon-triangle" d="M17 10H7l5 5 5-5Z" fill="white" />
          </svg>
          シリーズ・テーマ・タグで絞り込む
        </summary>
        <div class="article-search__detail-content dads-disclosure__content">
          <div class="article-search__filters">
            <div class="dads-form-control-label" data-size="md">
              <label class="dads-form-control-label__label" for="article-series">シリーズ</label>
              <select id="article-series" name="series">
                <option value="">すべてのシリーズ</option>
                {seriesList.map((series) => <option value={series.slug}>{series.title}</option>)}
              </select>
            </div>
            <div class="dads-form-control-label" data-size="md">
              <label class="dads-form-control-label__label" for="article-topic">テーマ</label>
              <select id="article-topic" name="topic">
                <option value="">すべてのテーマ</option>
                {Object.entries(topicLabels).map(([slug, label]) => <option value={slug}>{label}</option>)}
              </select>
            </div>
            <div class="dads-form-control-label" data-size="md">
              <label class="dads-form-control-label__label" for="article-tag">タグ</label>
              <select id="article-tag" name="tag">
                <option value="">すべてのタグ</option>
                {tags.map((tag) => <option value={tag}>{tag}</option>)}
              </select>
            </div>
          </div>
          <div class="article-search__detail-actions">
            <button class="dads-button" data-size="md" data-type="solid-fill" type="submit">この条件で絞り込む</button>
            <button class="dads-button article-search__reset" data-size="sm" data-type="text" type="button" data-reset-search>検索条件をクリア</button>
          </div>
        </div>
      </details>
    </form>

    <div class="article-search__active" data-active-filters hidden>
      <span>選択中の条件</span>
      <ul data-active-filter-list></ul>
    </div>
    <p class="article-count" data-article-count role="status" aria-live="polite" tabindex="-1">{articles.length}件の記事</p>
    <div class="article-list" data-article-list>
      {articles.map((article) => (
        <div
          data-article-item
          data-title={`${article.title} ${article.description} ${article.tags.join(" ")}`}
          data-series={articleSeries.get(article.slug) ?? ""}
          data-topic={article.topics.join(" ")}
          data-tags={article.tags.join("\n")}
        >
          <ArticleRow article={article} />
        </div>
      ))}
    </div>
    <nav class="article-pagination" data-pagination aria-label="記事一覧のページ" hidden>
      <button type="button" data-page-previous>前のページ</button>
      <ol data-pagination-pages></ol>
      <button type="button" data-page-next>次のページ</button>
    </nav>
    <div class="noema-empty-state" data-empty-state hidden={articles.length > 0}>
      <h2>{articles.length > 0 ? "該当する記事はありません" : "記事はまだありません"}</h2>
      {articles.length > 0 && <p>条件を解除するか、別の言葉やテーマをお試しください。</p>}
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".article-search");
  const keyword = document.querySelector<HTMLInputElement>("#article-keyword");
  const topic = document.querySelector<HTMLSelectElement>("#article-topic");
  const series = document.querySelector<HTMLSelectElement>("#article-series");
  const tag = document.querySelector<HTMLSelectElement>("#article-tag");
  const items = [...document.querySelectorAll<HTMLElement>("[data-article-item]")];
  const count = document.querySelector<HTMLElement>("[data-article-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");
  const reset = document.querySelector<HTMLButtonElement>("[data-reset-search]");
  const activeFilters = document.querySelector<HTMLElement>("[data-active-filters]");
  const activeFilterList = document.querySelector<HTMLUListElement>("[data-active-filter-list]");
  const filterDetails = document.querySelector<HTMLDetailsElement>("[data-filter-details]");
  const pagination = document.querySelector<HTMLElement>("[data-pagination]");
  const pageList = document.querySelector<HTMLOListElement>("[data-pagination-pages]");
  const previousPage = document.querySelector<HTMLButtonElement>("[data-page-previous]");
  const nextPage = document.querySelector<HTMLButtonElement>("[data-page-next]");
  const pageSize = 12;
  let currentPage = 1;

  const applyFilters = (updateUrl = true) => {
    const query = keyword?.value.trim().toLocaleLowerCase("ja") ?? "";
    const selectedTopic = topic?.value ?? "";
    const selectedSeries = series?.value ?? "";
    const selectedTag = tag?.value ?? "";
    const filteredItems = items.filter((item) => {
      const matchesText = !query || (item.dataset.title ?? "").toLocaleLowerCase("ja").includes(query);
      const matchesTopic = !selectedTopic || (item.dataset.topic ?? "").split(" ").includes(selectedTopic);
      const matchesSeries = !selectedSeries || item.dataset.series === selectedSeries;
      const matchesTag = !selectedTag || (item.dataset.tags ?? "").split("\n").includes(selectedTag);
      return matchesText && matchesSeries && matchesTopic && matchesTag;
    });
    const totalPages = Math.max(1, Math.ceil(filteredItems.length / pageSize));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const visibleItems = new Set(filteredItems.slice((currentPage - 1) * pageSize, currentPage * pageSize));
    for (const item of items) {
      item.hidden = !visibleItems.has(item);
    }
    if (count) count.textContent = totalPages > 1
      ? `${filteredItems.length}件の記事（${currentPage}/${totalPages}ページ）`
      : `${filteredItems.length}件の記事`;
    if (empty) empty.hidden = filteredItems.length > 0;
    if (activeFilters && activeFilterList) {
      activeFilterList.replaceChildren();
      const filters = [
        ...(query ? [`キーワード: ${keyword?.value.trim()}`] : []),
        ...(selectedSeries && series ? [`シリーズ: ${series.options[series.selectedIndex]?.text ?? selectedSeries}`] : []),
        ...(selectedTopic && topic ? [`テーマ: ${topic.options[topic.selectedIndex]?.text ?? selectedTopic}`] : []),
        ...(selectedTag ? [`タグ: ${selectedTag}`] : [])
      ];
      for (const filter of filters) {
        const item = document.createElement("li");
        item.textContent = filter;
        activeFilterList.append(item);
      }
      activeFilters.hidden = filters.length === 0;
    }
    if (pagination && pageList && previousPage && nextPage) {
      pagination.hidden = totalPages <= 1;
      previousPage.disabled = currentPage <= 1;
      nextPage.disabled = currentPage >= totalPages;
      pageList.replaceChildren();
      for (let page = 1; page <= totalPages; page += 1) {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(page);
        button.dataset.page = String(page);
        button.setAttribute("aria-label", `${page}ページ目`);
        if (page === currentPage) button.setAttribute("aria-current", "page");
        item.append(button);
        pageList.append(item);
      }
    }
    if (updateUrl) {
      const params = new URLSearchParams();
      if (keyword?.value.trim()) params.set("keyword", keyword.value.trim());
      if (series?.value) params.set("series", series.value);
      if (topic?.value) params.set("topic", topic.value);
      if (tag?.value) params.set("tag", tag.value);
      if (currentPage > 1) params.set("page", String(currentPage));
      window.history.replaceState(null, "", `${window.location.pathname}${params.size ? `?${params}` : ""}#search`);
    }
  };

  const initialParams = new URLSearchParams(window.location.search);
  if (keyword) keyword.value = initialParams.get("keyword") ?? "";
  if (series) series.value = initialParams.get("series") ?? "";
  if (topic) topic.value = initialParams.get("topic") ?? "";
  if (tag) tag.value = initialParams.get("tag") ?? "";
  if (filterDetails && (series?.value || topic?.value || tag?.value)) filterDetails.open = true;
  currentPage = Number.parseInt(initialParams.get("page") ?? "1", 10) || 1;
  applyFilters(false);

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    currentPage = 1;
    applyFilters();
  });
  reset?.addEventListener("click", () => {
    if (keyword) keyword.value = "";
    if (series) series.value = "";
    if (topic) topic.value = "";
    if (tag) tag.value = "";
    currentPage = 1;
    applyFilters();
    keyword?.focus();
  });
  previousPage?.addEventListener("click", () => { currentPage -= 1; applyFilters(); });
  nextPage?.addEventListener("click", () => { currentPage += 1; applyFilters(); });
  pageList?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-page]");
    if (!button) return;
    currentPage = Number(button.dataset.page);
    applyFilters();
    count?.focus();
  });
</script>
