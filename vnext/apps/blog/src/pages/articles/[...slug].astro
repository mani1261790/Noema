---
import { extractArticleLinkReferences, topicLabels } from "@noema/content";
import { createArticleMarkdownRenderer } from "@noema/content/article-renderer";
import ArticleAssistant from "../../components/ArticleAssistant.astro";
import ArticleAnalytics from "../../components/ArticleAnalytics.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findRelatedArticles, toArticleSummary } from "../../lib/articles";
import { getArticleLinkAvailability, getPublishedArticleBySlug, getPublishedArticleRedirect, getPublishedSeriesByArticleSlug, listPublicArticleSummaries } from "../../lib/cms-publications";
import { renderArticlePresentation } from "@noema/content/article-presentation";

const slug = Astro.params.slug ?? "";
const article = await getPublishedArticleBySlug(slug);
if (!article) {
  const redirectSlug = await getPublishedArticleRedirect(slug);
  if (redirectSlug) return Astro.redirect(`/articles/${redirectSlug}/`, 301);
  return Astro.rewrite("/404");
}
const articleLinkReferences = extractArticleLinkReferences(article.markdown);
const [summaries, series, articleLinkAvailability] = await Promise.all([
  listPublicArticleSummaries(),
  getPublishedSeriesByArticleSlug(slug),
  getArticleLinkAvailability(articleLinkReferences.map((reference) => reference.slug), article.visibility)
]);
const unavailableArticleHrefs = new Set(
  articleLinkReferences
    .filter((reference) => articleLinkAvailability.get(reference.slug) !== "available")
    .map((reference) => reference.href)
);
const markdownRenderer = createArticleMarkdownRenderer({
  resolveLinkAvailability: (href) => unavailableArticleHrefs.has(href) ? "unavailable" : "available"
});
const currentSummary = toArticleSummary(article.data);
const seriesSlugs = new Set(series?.items.map((item) => item.slug) ?? []);
const relatedArticles = findRelatedArticles(
  currentSummary,
  summaries.filter((item) => !seriesSlugs.has(item.slug)),
);
const presentationHtml = renderArticlePresentation(article.data, article.markdown, {
  editor: article.editor ? { href: article.editor.href, name: article.editor.displayName } : null,
  markdownRenderer,
  series: series ? {
    currentIndex: series.currentIndex,
    description: series.description,
    href: series.href,
    items: series.items,
    title: series.title
  } : null
});
const canonicalUrl = new URL(`/articles/${article.data.slug}/`, Astro.site ?? "https://noema-learn.uk");
const ogImagePath = "/og/default.png";
const ogImageUrl = new URL(ogImagePath, Astro.site ?? "https://noema-learn.uk");
const attributedAuthors = article.editor ? [article.editor.displayName] : article.data.authors;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt,
  dateModified: article.data.updatedAt,
  inLanguage: "ja",
  mainEntityOfPage: canonicalUrl.toString(),
  image: [ogImageUrl.toString()],
  author: attributedAuthors.map((name: string) => ({
    "@type": "Person",
    name,
    ...(article.editor ? { url: new URL(article.editor.href, canonicalUrl).toString() } : {})
  })),
  publisher: { "@type": "Organization", name: "Noema", url: new URL("/", canonicalUrl).toString() }
};
const topic = article.data.topics[0] ?? "technology";
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
---

<BaseLayout
  title={`${article.data.title} | Noema`}
  description={article.data.description}
  noindex={article.visibility === "unlisted"}
  image={ogImagePath}
  pageType="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  authors={attributedAuthors}
  jsonLd={jsonLd}
>
  <ArticleAnalytics slug={article.data.slug} />
  <div class="noema-container article-page">
    <div class="article-page__main">
      <Breadcrumbs items={series
        ? [{ label: "ホーム", href: "/" }, { label: "シリーズ", href: "/series" }, { label: series.title, href: series.href }, { label: article.data.title }]
        : [{ label: "ホーム", href: "/" }, { label: "記事を探す", href: "/articles" }, { label: article.data.title }]} />
      <Fragment set:html={presentationHtml} />
      <ShareArticle />
      <RelatedArticles articles={relatedArticles} />
      <nav class="article-end-navigation" aria-label="記事を読み終えた後のリンク">
        {series && <a class="dads-link" href={series.href}>{`${series.title}の一覧を見る`}</a>}
        <a class="dads-link" href={`/topics/${topic}`}>{`${topicLabel}の記事を見る`}</a>
        <a class="dads-link" href="/articles">すべての記事を見る</a>
      </nav>
    </div>
    <div class="article-page__aside"><ArticleAssistant slug={article.data.slug} /></div>
  </div>
</BaseLayout>
