---
import { getCollection, render } from "astro:content";
import { stageLabels, topicLabels, trackLabels } from "@noema/content";
import ArticleAssistant from "../../components/ArticleAssistant.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.status === "published");
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const topic = article.data.topics[0] ?? "technology";
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
const tocItems = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ href: `#${heading.slug}`, label: heading.text }));
---

<BaseLayout title={`${article.data.title} | Noema`} description={article.data.description}>
  <div class="noema-container article-page">
    <div class="article-page__main">
      <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: topicLabel, href: `/topics/${topic}` }, { label: article.data.title }]} />
      <header class="article-header">
        <h1>{article.data.title}</h1>
        <p>{article.data.description}</p>
        <dl class="article-meta">
          <div><dt class="noema-visually-hidden">学習段階</dt><dd><span class="article-meta__level">{stageLabels[article.data.stage]}</span></dd></div>
          {article.data.track !== "common" && <div><dt class="noema-visually-hidden">発展トラック</dt><dd>{trackLabels[article.data.track]}</dd></div>}
          <div><dt class="noema-visually-hidden">読了時間</dt><dd>読了 {article.data.estimatedMinutes}分</dd></div>
          <div><dt class="noema-visually-hidden">更新日</dt><dd><time datetime={article.data.updatedAt}>{article.data.updatedAt}</time></dd></div>
        </dl>
      </header>
      <section class="article-learning-summary" aria-labelledby="article-outcome-heading">
        <h2 id="article-outcome-heading">この記事でできるようになること</h2>
        <p>{article.data.outcome}</p>
        {article.data.prerequisites.length > 0 && (
          <div>
            <h3>読む前に知っておくこと</h3>
            <ul>{article.data.prerequisites.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
      </section>
      {tocItems.length > 0 && <ArticleToc items={tocItems} />}
      <article class="article-body"><Content /></article>
    </div>
    <div class="article-page__aside"><ArticleAssistant slug={article.data.slug} /></div>
  </div>
</BaseLayout>
