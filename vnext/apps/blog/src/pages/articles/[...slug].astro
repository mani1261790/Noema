---
import { articleOgImagePath } from "../../lib/article-og";
import { topicLabels } from "@noema/content";
import { analyzeArticleMarkdown } from "@noema/content";
import { createArticleMarkdownRenderer } from "@noema/content/article-renderer";
import ArticleAssistant from "../../components/ArticleAssistant.astro";
import ArticleAnalytics from "../../components/ArticleAnalytics.astro";
import ArticleUpdatesCta from "../../components/ArticleUpdatesCta.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findRelatedArticles, toArticleSummary } from "../../lib/articles";
import { getArticleAssetDimensions, getArticleLinkAvailability, getPublishedArticleBySlug, getPublishedArticleRedirect, getPublishedSeriesByArticleSlug, listPublicArticleSummaries } from "../../lib/cms-publications";
import { renderArticlePresentation } from "@noema/content/article-presentation";
import { articleJsonLd } from "../../lib/seo";
import { findNarrowingTopicForArticle } from "../../lib/topics";

const slug = Astro.params.slug ?? "";
const article = await getPublishedArticleBySlug(slug);
if (!article) {
  const redirectSlug = await getPublishedArticleRedirect(slug);
  if (redirectSlug) return Astro.redirect(`/articles/${redirectSlug}`, 301);
  return Astro.rewrite("/404");
}
const analysis = analyzeArticleMarkdown(article.markdown);
const articleLinkReferences = analysis.links;
const articleImageReferences = analysis.images;
if (article.data.heroImage) articleImageReferences.push(article.data.heroImage.src);
const [summaries, series, articleLinkAvailability, articleImageDimensions] = await Promise.all([
  listPublicArticleSummaries({ includeFeatures: false }),
  getPublishedSeriesByArticleSlug(slug),
  getArticleLinkAvailability(articleLinkReferences.map((reference) => reference.slug), article.visibility),
  getArticleAssetDimensions(articleImageReferences)
]);
const unavailableArticleHrefs = new Set(
  articleLinkReferences
    .filter((reference) => articleLinkAvailability.get(reference.slug) !== "available")
    .map((reference) => reference.href)
);
const markdownRenderer = createArticleMarkdownRenderer({
  resolveImageDimensions: (reference) => articleImageDimensions.get(reference),
  resolveLinkAvailability: (href) => unavailableArticleHrefs.has(href) ? "unavailable" : "available"
});
const currentSummary = toArticleSummary(article.data, article.markdown);
const seriesSlugs = new Set(series?.items.map((item) => item.slug) ?? []);
const relatedCandidates = findRelatedArticles(
  currentSummary,
  summaries.filter((item) => !seriesSlugs.has(item.slug)),
);
// Fetch feature-detection bodies only for the few articles that will be shown.
const relatedArticles = relatedCandidates.length
  ? await listPublicArticleSummaries({ slugs: relatedCandidates.map((item) => item.slug) })
  : [];
relatedArticles.sort((a, b) => relatedCandidates.findIndex((item) => item.slug === a.slug) - relatedCandidates.findIndex((item) => item.slug === b.slug));
const presentationHtml = renderArticlePresentation(article.data, article.markdown, {
  editor: article.editor ? { href: article.editor.href, name: article.editor.displayName } : null,
  markdownRenderer,
  headings: analysis.headings,
  resolveImageDimensions: (reference) => articleImageDimensions.get(reference),
  series: series ? {
    currentIndex: series.currentIndex,
    description: series.description,
    href: series.href,
    items: series.items,
    title: series.title
  } : null
});
const attributedAuthors = article.editor ? [article.editor.displayName] : article.data.authors;
const heroImageDimensions = article.data.heroImage
  ? articleImageDimensions.get(article.data.heroImage.src)
  : undefined;
const socialImage = new URL(articleOgImagePath({ slug: article.data.slug, title: article.data.title, topic: topicLabels[article.data.topics[0]] ?? "AIと技術" }), Astro.url.origin).href;
const jsonLd = articleJsonLd({
  authors: attributedAuthors.map((name: string) => ({
    name,
    ...(article.editor ? { url: article.editor.href } : {})
  })),
  description: article.data.description,
  headline: article.data.title,
  image: article.data.heroImage ? {
    src: article.data.heroImage.src,
    ...heroImageDimensions,
  } : undefined,
  pathname: `/articles/${article.data.slug}`,
  publishedAt: article.publishedAt,
  updatedAt: article.updatedAt
}, Astro.site);
const narrowingTopic = findNarrowingTopicForArticle(currentSummary, summaries);
---

<BaseLayout
  title={`${article.data.title} | Noema`}
  socialTitle={article.data.title}
  description={article.data.description}
  noindex={article.visibility === "unlisted"}
  image={socialImage}
  imageAlt={`${article.data.title} — Noemaの記事`}
  imageHeight={630}
  imageWidth={1200}
  pageType="article"
  publishedAt={article.publishedAt}
  updatedAt={article.updatedAt}
  authors={attributedAuthors}
  jsonLd={jsonLd}
>
  <ArticleAnalytics slug={article.data.slug} />
  <div class="noema-container article-page">
    <div class="article-page__main">
      <Breadcrumbs items={series
        ? [{ label: "ホーム", href: "/" }, { label: "シリーズ", href: "/series" }, { label: series.title, href: series.href }, { label: article.data.title }]
        : [{ label: "ホーム", href: "/" }, { label: "記事を探す", href: "/articles" }, { label: article.data.title }]} />
      <Fragment set:html={presentationHtml} />
      <div class="article-question-entry"><button type="button" class="article-question-button" data-ask-article aria-controls="article-assistant-panel" aria-expanded="false">AIに質問</button><p>気になる本文を選択して、その箇所について質問することもできます。</p></div>
      <RelatedArticles articles={relatedArticles} current={currentSummary} />
      <ShareArticle title={article.data.title} pathname={`/articles/${article.data.slug}`} />
      <ArticleUpdatesCta slug={article.data.slug} />
      <nav class="article-end-navigation" aria-label="記事を読み終えた後のリンク">
        {series && <a class="dads-link" data-analytics-discovery="series_index" href={series.href}>{`${series.title}の一覧を見る`}</a>}
        {narrowingTopic && (
          <a class="dads-link" data-analytics-discovery="topic" href={`/topics/${narrowingTopic.slug}`}>{`${narrowingTopic.label}の記事を見る`}</a>
        )}
        <a class="dads-link" data-analytics-discovery="article_index" href="/articles">すべての記事を見る</a>
      </nav>
    </div>
    <div class="article-page__aside"><ArticleAssistant slug={article.data.slug} /></div>
  </div>
</BaseLayout>
