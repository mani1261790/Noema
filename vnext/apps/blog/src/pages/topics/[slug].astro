---
import { articleTopicSchema, topicDescriptions, topicLabels } from "@noema/content";
import ArticleRow from "../../components/ArticleRow.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublicArticleSummaries } from "../../lib/cms-publications";
import { collectionPageJsonLd } from "../../lib/seo";

const { slug } = Astro.params;
const topic = articleTopicSchema.safeParse(slug);
if (!topic.success) return new Response("Not found", { status: 404 });
const label = topicLabels[topic.data];
const description = topicDescriptions[topic.data];
const allArticles = await listPublicArticleSummaries();
const articles = allArticles.filter((article) => article.topics.includes(topic.data));
const pathname = `/topics/${topic.data}`;
const jsonLd = collectionPageJsonLd({
  description,
  items: articles.map((article) => ({ name: article.title, pathname: article.href })),
  name: `${label}の記事`,
  pathname,
}, Astro.site);
---

<BaseLayout title={`${label}の記事 | Noema`} description={description} jsonLd={jsonLd}>
  <div class="noema-container listing-page">
    <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "テーマから探す", href: "/#topic-heading" }, { label }]} />
    <header class="page-heading">
      <h1>{label}</h1>
      <p>{description}</p>
    </header>
    {articles.length > 0 ? (
      <div class="article-list">{articles.map((article) => <ArticleRow article={article} />)}</div>
    ) : (
      <div class="noema-empty-state"><h2>記事はまだありません</h2></div>
    )}
  </div>
</BaseLayout>
