---
import { articleTopicSchema, previewArticles, topicDescriptions, topicLabels } from "@noema/content";
import ArticleRow from "../../components/ArticleRow.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;
export function getStaticPaths() {
  return Object.entries(topicLabels).map(([slug, label]) => ({ params: { slug }, props: { label } }));
}

const { slug } = Astro.params;
const { label } = Astro.props;
const showPreview = import.meta.env.DEV || import.meta.env.NOEMA_PREVIEW_CONTENT === "1";
const topic = articleTopicSchema.safeParse(slug);
const description = topic.success ? topicDescriptions[topic.data] : "";
const articles = showPreview && topic.success
  ? previewArticles.filter((article) => article.topics.includes(topic.data))
  : [];
---

<BaseLayout title={`${label}の記事 | Noema`} description={description}>
  <div class="noema-container listing-page">
    <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "テーマから探す", href: "/#topic-heading" }, { label }]} />
    <header class="page-heading">
      <h1>{label}</h1>
      <p>{description}</p>
    </header>
    {articles.length > 0 ? (
      <div class="article-list">{articles.map((article) => <ArticleRow article={article} />)}</div>
    ) : (
      <div class="noema-empty-state"><h2>記事はまだありません</h2></div>
    )}
  </div>
</BaseLayout>
