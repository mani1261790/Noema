---
import MarkdownIt from "markdown-it";
import { previewArticles, previewArticleMarkdown } from "@noema/content";
import ArticleAssistant from "../../components/ArticleAssistant.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FeedbackDiagram from "../../components/FeedbackDiagram.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;
const article = previewArticles[0];
const md = new MarkdownIt({ html: false, linkify: true, typographer: true });
const [firstSection, ...remainingSections] = previewArticleMarkdown.trim().split("## フィードバックとは何か");
const firstHtml = md.render(firstSection);
const remainingHtml = md.render(`## フィードバックとは何か${remainingSections.join("## フィードバックとは何か")}`);
const tocItems = [
  { href: "#身近な例", label: "まず、身近な例から" },
  { href: "#フィードバック", label: "フィードバックとは何か" },
  { href: "#安定", label: "なぜ安定するのか" },
  { href: "#まとめ", label: "まとめ" }
];
---

<BaseLayout title={`${article.title} | Noema`} description={article.description} noindex>
  <div class="preview-banner" role="note">UI確認用のfixture記事です。公開コンテンツではありません。</div>
  <div class="noema-container article-page">
    <div class="article-page__main">
      <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "制御工学", href: "/topics/control-engineering" }, { label: article.title }]} />
      <header class="article-header">
        <h1>{article.title}</h1>
        <p>{article.description}</p>
        <dl class="article-meta">
          <div><dt class="noema-visually-hidden">難易度</dt><dd><span class="article-meta__level">入門</span></dd></div>
          <div><dt class="noema-visually-hidden">読了時間</dt><dd>読了 {article.estimatedMinutes}分</dd></div>
          <div><dt class="noema-visually-hidden">更新日</dt><dd><time datetime={article.updatedAt}>2026年7月10日</time></dd></div>
        </dl>
      </header>

      <ArticleToc items={tocItems} />

      <article class="article-body">
        <div id="身近な例" set:html={firstHtml} />
        <div id="フィードバック" set:html={remainingHtml.split('<h2>なぜ安定するのか</h2>')[0]} />
        <FeedbackDiagram />
        <div id="安定" set:html={`<h2>なぜ安定するのか</h2>${remainingHtml.split('<h2>なぜ安定するのか</h2>')[1]?.split('<h2>まとめ</h2>')[0] ?? ""}`} />
        <div id="まとめ" set:html={`<h2>まとめ</h2>${remainingHtml.split('<h2>まとめ</h2>')[1] ?? ""}`} />
        <section class="article-sources" aria-labelledby="source-heading">
          <h2 id="source-heading">この記事の出典</h2>
          <p>UI確認用fixtureのため、実際の公開時には著者が確認した出典を掲載します。</p>
        </section>
      </article>
    </div>
    <div class="article-page__aside">
      <ArticleAssistant slug={article.slug} />
    </div>
  </div>
</BaseLayout>
