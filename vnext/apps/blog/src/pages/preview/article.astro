---
import MarkdownIt from "markdown-it";
import { previewArticles, previewArticleMarkdown, topicLabels } from "@noema/content";
import ArticleAssistant from "../../components/ArticleAssistant.astro";
import ArticleSources from "../../components/ArticleSources.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findRelatedArticles, formatJapaneseDate } from "../../lib/articles";
import { extractArticleHeadings } from "../../lib/article-assistant";

export const prerender = true;
const article = previewArticles[0];
const md = new MarkdownIt({ html: false, linkify: true, typographer: true });
const articleHeadings = extractArticleHeadings(previewArticleMarkdown);
const sections = previewArticleMarkdown
  .trim()
  .split(/^## /m)
  .filter(Boolean)
  .map((section, index) => {
    const [heading, ...body] = section.split("\n");
    return { id: articleHeadings[index]?.id ?? `section-${index + 1}`, heading, html: md.render(body.join("\n").trim()) };
  });
const tocItems = sections.map((section) => ({ href: `#${section.id}`, label: section.heading }));
const topic = article.topics[0];
const topicLabel = topicLabels[topic as keyof typeof topicLabels] ?? topic;
const relatedArticles = findRelatedArticles(article, previewArticles);
---

<BaseLayout title={`${article.title} | Noema`} description={article.description} image="/og/preview.png" pageType="article" noindex>
  <div class="noema-container article-page">
    <div class="article-page__main">
      <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: topicLabel, href: `/topics/${topic}` }, { label: article.title }]} />
      <header class="article-header">
        <h1>{article.title}</h1>
        <p>{article.description}</p>
        <dl class="article-meta">
          <div><dt>執筆</dt><dd>{article.authors.join("、")}</dd></div>
          <div><dt class="noema-visually-hidden">読了時間</dt><dd>読了 {article.estimatedMinutes}分</dd></div>
          {article.publishedAt && <div><dt>公開</dt><dd><time datetime={article.publishedAt}>{formatJapaneseDate(article.publishedAt)}</time></dd></div>}
          <div><dt>更新</dt><dd><time datetime={article.updatedAt}>{formatJapaneseDate(article.updatedAt)}</time></dd></div>
        </dl>
        {article.tags.length > 0 && (
          <ul class="article-header__tags" aria-label="タグ">
            {article.tags.map((tag) => <li><a href={`/articles?tag=${encodeURIComponent(tag)}#search`}>{tag}</a></li>)}
          </ul>
        )}
      </header>

      {article.heroImage && (
        <figure class="article-hero-image">
          <img src={article.heroImage.src} alt={article.heroImage.alt} />
        </figure>
      )}

      <ArticleToc items={tocItems} />

      <article class="article-body">
        {sections.map((section) => (
          <section id={section.id}>
            <h2>{section.heading}</h2>
            <div set:html={section.html} />
          </section>
        ))}
      </article>
      <ArticleSources sources={article.sources} />
      <ShareArticle />
      <RelatedArticles articles={relatedArticles} />
      <nav class="article-end-navigation" aria-label="記事を読み終えた後のリンク">
        <a class="dads-link" href={`/topics/${topic}`}>{`${topicLabel}の記事を見る`}</a>
        <a class="dads-link" href="/articles">すべての記事を見る</a>
      </nav>
    </div>
    <div class="article-page__aside">
      <ArticleAssistant slug={article.slug} />
    </div>
  </div>
</BaseLayout>
