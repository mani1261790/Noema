{
  "name": "@noema/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "node scripts/require-public-site-url.mjs && npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@noema/content": "0.1.0",
    "@noema/ui": "0.1.0",
    "dompurify": "^3.4.11",
    "markdown-it": "^14.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
